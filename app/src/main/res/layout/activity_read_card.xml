<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/lanhu_white">

    <!-- Toolbar: back + Detect Card -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="16dp">

        <ImageButton
            android:id="@+id/btn_back"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/back"
            android:src="@android:drawable/ic_menu_revert"
            android:scaleType="centerInside" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:text="@string/detect_card_title"
            android:textColor="@color/lanhu_text_dark"
            android:textSize="28sp"
            android:fontFamily="sans-serif-medium" />
    </LinearLayout>

    <!-- Amount info card -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="16dp"
        android:layout_marginTop="16dp"
        android:background="@drawable/bg_amount_info"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="16dp">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/trans_amount_label"
            android:textColor="@color/lanhu_text_dark"
            android:textSize="18sp" />

        <TextView
            android:id="@+id/read_card_amount"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/lanhu_blue"
            android:textSize="24sp"
            android:fontFamily="sans-serif-medium" />
    </LinearLayout>

    <!-- Prompt -->
    <TextView
        android:id="@+id/read_card_prompt"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="32dp"
        android:text="@string/please_swipe_insert_tap"
        android:textColor="@color/lanhu_text_dark"
        android:textSize="20sp" />

    <!-- Retry button (visible on failure) -->
    <Button
        android:id="@+id/btn_retry"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="16dp"
        android:text="@string/retry"
        android:visibility="gone" />

    <!-- Three card icons -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="center"
        android:orientation="horizontal"
        android:padding="24dp">

        <ImageView
            android:id="@+id/icon_swipe"
            android:layout_width="90dp"
            android:layout_height="110dp"
            android:layout_marginHorizontal="8dp"
            android:contentDescription="@string/swipe_card"
            android:src="@drawable/sale_demo_icon_swipe_card" />

        <ImageView
            android:id="@+id/icon_insert"
            android:layout_width="90dp"
            android:layout_height="110dp"
            android:layout_marginHorizontal="8dp"
            android:contentDescription="@string/insert_card"
            android:src="@drawable/sale_demo_icon_insert_card" />

        <ImageView
            android:id="@+id/icon_tap"
            android:layout_width="90dp"
            android:layout_height="110dp"
            android:layout_marginHorizontal="8dp"
            android:contentDescription="@string/tap_card"
            android:src="@drawable/sale_demo_icon_tap_card" />
    </LinearLayout>

    <!-- Using Scan Code (placeholder) -->
    <Button
        android:id="@+id/btn_scan_code"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="16dp"
        android:layout_marginBottom="24dp"
        android:background="@drawable/bg_scan_code"
        android:enabled="false"
        android:text="@string/using_scan_code"
        android:textColor="@color/lanhu_white"
        android:textSize="20sp"
        android:fontFamily="sans-serif-medium" />
</LinearLayout>
