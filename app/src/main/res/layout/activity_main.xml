<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/lanhu_white">

    <!-- Title bar: SALE DEMO + settings icon -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:paddingHorizontal="16dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerInParent="true"
            android:text="@string/sale_demo_title"
            android:textColor="@color/lanhu_text_dark"
            android:textSize="32sp"
            android:fontFamily="sans-serif-medium" />

        <ImageButton
            android:id="@+id/btn_settings"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/settings"
            android:src="@android:drawable/ic_menu_preferences"
            android:scaleType="centerInside" />
    </RelativeLayout>

    <!-- Amount display: weight=1, fills remaining space after keyboard -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginHorizontal="14dp"
        android:layout_marginTop="16dp"
        android:layout_marginBottom="8dp"
        android:background="@drawable/bg_amount_display"
        android:padding="24dp">

        <TextView
            android:id="@+id/amount_display"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center_vertical"
            android:gravity="end"
            android:text="$ 0.00"
            android:textColor="@color/lanhu_text_dark"
            android:textSize="48sp"
            android:fontFamily="sans-serif-medium" />
    </FrameLayout>

    <!-- Keypad area: weight=2, same proportion as Adjust TIP page -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="2"
        android:background="@color/lanhu_white"
        android:padding="8dp"
        android:orientation="vertical">

        <!-- Row 0: 1, 2, 3, CLEAR -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btn_1"
                style="@style/Widget.PaymentDemo.NumpadKey"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:text="1" />
            <Button
                android:id="@+id/btn_2"
                style="@style/Widget.PaymentDemo.NumpadKey"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:text="2" />
            <Button
                android:id="@+id/btn_3"
                style="@style/Widget.PaymentDemo.NumpadKey"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:text="3" />
            <Button
                android:id="@+id/btn_clear"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_margin="4dp"
                android:background="@drawable/bg_btn_clear"
                android:text="CLEAR"
                android:textColor="@color/lanhu_white"
                android:textSize="20sp"
                android:fontFamily="sans-serif-medium" />
        </LinearLayout>

        <!-- Rows 1-3: left 3 columns + DONE spanning all 3 rows -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="3"
            android:orientation="horizontal">

            <!-- Left 3 columns: rows 1-3 -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="3"
                android:orientation="vertical">

                <!-- Row 1: 4, 5, 6 -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1"
                    android:orientation="horizontal">

                    <Button
                        android:id="@+id/btn_4"
                        style="@style/Widget.PaymentDemo.NumpadKey"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:text="4" />
                    <Button
                        android:id="@+id/btn_5"
                        style="@style/Widget.PaymentDemo.NumpadKey"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:text="5" />
                    <Button
                        android:id="@+id/btn_6"
                        style="@style/Widget.PaymentDemo.NumpadKey"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:text="6" />
                </LinearLayout>

                <!-- Row 2: 7, 8, 9 -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1"
                    android:orientation="horizontal">

                    <Button
                        android:id="@+id/btn_7"
                        style="@style/Widget.PaymentDemo.NumpadKey"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:text="7" />
                    <Button
                        android:id="@+id/btn_8"
                        style="@style/Widget.PaymentDemo.NumpadKey"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:text="8" />
                    <Button
                        android:id="@+id/btn_9"
                        style="@style/Widget.PaymentDemo.NumpadKey"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:text="9" />
                </LinearLayout>

                <!-- Row 3: 000, 00, 0 -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1"
                    android:orientation="horizontal">

                    <Button
                        android:id="@+id/btn_000"
                        style="@style/Widget.PaymentDemo.NumpadKey"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:text="000" />
                    <Button
                        android:id="@+id/btn_00"
                        style="@style/Widget.PaymentDemo.NumpadKey"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:text="00" />
                    <Button
                        android:id="@+id/btn_0"
                        style="@style/Widget.PaymentDemo.NumpadKey"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:text="0" />
                </LinearLayout>
            </LinearLayout>

            <!-- DONE button spanning all 3 rows -->
            <Button
                android:id="@+id/btn_done"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_margin="4dp"
                android:background="@drawable/bg_btn_done"
                android:text="DONE"
                android:textColor="@color/lanhu_white"
                android:textSize="24sp"
                android:fontFamily="sans-serif-medium" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
